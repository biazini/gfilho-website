  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "Is the site reachable right now? Public site = all public pages pass from the internet (DNS → Cloudflare → tunnel → nginx); Origin = nginx answered directly. Public DOWN with Origin UP points at Cloudflare or the tunnel; both DOWN at nginx or WSL. UNKNOWN = Prometheus cannot reach the probe exporter. Response time colours follow the web.dev TTFB guidance (0.8 s / 1.8 s). p95, Availability and Monitored cover the selected range; Availability counts only the time monitoring was running, and Monitored says how much of the range that was (below 100 % = WSL or the stack was off). The probes run from this PC, so a local network fault looks like an outage: pair this with an external uptime monitor (README → Monitoring).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(probe_success{job=\"blackbox_public\"} or up{job=\"blackbox_public\"} * 0 + 0.5)) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(probe_success{job=\"blackbox_origin\", instance=\"http://127.0.0.1:8088/\"} or up{job=\"blackbox_origin\", instance=\"http://127.0.0.1:8088/\"} * 0 + 0.5)) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(cloudflared_tunnel_ha_connections or up{job=\"cloudflared\"} * 0) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(probe_duration_seconds{job=\"blackbox_public\", instance=\"https://gfilho.net/\"})) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "E",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(quantile_over_time(0.95, probe_duration_seconds{job=\"blackbox_public\", instance=\"https://gfilho.net/\"}[$__range]))) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "F",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(sum_over_time(probe_success{job=\"blackbox_public\", instance=\"https://gfilho.net/\"}[$__range])) / sum(count_over_time(probe_success{job=\"blackbox_public\", instance=\"https://gfilho.net/\"}[$__range]))) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "G",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp_max(sum(count_over_time(probe_success{job=\"blackbox_public\", instance=\"https://gfilho.net/\"}[$__range])) / ($__range_s / 60), 1)) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "H",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
