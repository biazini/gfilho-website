{
  "uid": "gfilho-overview",
  "title": "gfilho.net — Overview",
  "description": "Is gfilho.net reachable, fast and healthy: status, lifecycle, uptime, alerts, public latency and traffic",
  "tags": [
    "gfilho.net",
    "website"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 4,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#5794F2",
        "name": "Deploys",
        "expr": "changes(gfilho_last_deploy_timestamp_seconds{target=\"production\"}[3m]) > 0",
        "step": "1m",
        "titleFormat": "Deploy to production",
        "textFormat": "deploy.sh production"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "name": "WSL starts",
        "expr": "time() - node_boot_time_seconds < 600",
        "step": "1m",
        "titleFormat": "WSL started",
        "textFormat": "WSL was not running before this point: the site was offline"
      }
    ]
  },
  "links": [
    {
      "title": "gfilho.net dashboards",
      "type": "dashboards",
