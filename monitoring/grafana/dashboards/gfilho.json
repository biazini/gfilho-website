    {
      "id": 2,
      "type": "stat",
      "title": "Lifecycle",
      "description": "Time left until the TLS certificate (earliest expiry among every HTTPS address probed; Cloudflare renews it) and /.well-known/security.txt expire (renew it before 30 days: the SecurityTxtExpiringSoon alert fires then). WSL offline = time WSL was not running, from the systemd journal: the site was down then.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(probe_ssl_earliest_cert_expiry{job=~\"blackbox_public|blackbox_redirects\"}) - time()) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(gfilho_security_txt_expires_timestamp_seconds - time()) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - gfilho_last_deploy_timestamp_seconds{target=\"production\"}) or on() vector(NaN)",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(gfilho_wsl_offline_seconds{window=\"24h\"}) or on() vector(NaN)",
