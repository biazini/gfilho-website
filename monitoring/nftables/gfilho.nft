# Installed as /etc/nftables.d/gfilho.nft by monitoring/install-monitoring.sh (included from /etc/nftables.conf).
# Grafana listens on 10.10.10.26:3000 so the Nginx Proxy Manager (LXC 100, 10.10.10.10) can publish it as
# https://grafana.lab.guilhermefilho.com. Nothing else on the network may reach it.
table inet gfilho
delete table inet gfilho
table inet gfilho {
  chain input {
    type filter hook input priority 0; policy accept;
    # exporters, Alloy and the tunnel metrics: only the gfhomelab observability stack (CT 108)
    tcp dport { 9100, 9113, 9115, 12345, 20241 } ip saddr 10.10.10.27 accept
    tcp dport { 9100, 9113, 9115, 12345, 20241 } iifname != "lo" drop
  }
}
