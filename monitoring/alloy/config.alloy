// Alloy: ships the nginx logs and the journal of the site's services to Loki: the local one (127.0.0.1:3100)
// and the gfhomelab observability stack in CT 108 (10.10.10.27:3100).
// Labels stay few (job, log, env, unit); fields such as status and path are parsed at query time.

local.file_match "nginx" {
  path_targets = [
    {"__path__" = "/var/log/nginx/access.log", "job" = "nginx", "log" = "access", "env" = "production"},
    {"__path__" = "/var/log/nginx/gfilho-staging.access.log", "job" = "nginx", "log" = "access", "env" = "staging"},
    {"__path__" = "/var/log/nginx/error.log", "job" = "nginx", "log" = "error"},
  ]
}

loki.source.file "nginx" {
  targets       = local.file_match.nginx.targets
  // first run reads the current files from the start (today's traffic); positions are kept afterwards
  forward_to    = [loki.process.nginx.receiver]
  tail_from_end = false
}

loki.process "nginx" {
  // access log (log_format gfilho):
  // 85.240.1.2 - - [18/Nov/2026:16:40:18 +0000] "GET / HTTP/1.1" 200 5712 "-" "Mozilla/5.0 ..." rt=0.000 port=8088 ip_country=PT
  stage.match {
    selector = "{log=\"access\"}"
    stage.regex {
      expression = "^(?P<ip>\\S+) - \\S+ \\[(?P<ts>[^\\]]+)\\] \"(?P<method>\\S+) (?P<path>\\S+)[^\"]*\" (?P<status>\\d{3}) (?P<bytes>\\d+) \"(?P<referer>[^\"]*)\" \"(?P<agent>[^\"]*)\"(?: rt=\\S+)?(?: port=\\S+)?(?: ip_country=(?P<country>\\S*))?"
    }
    stage.timestamp {
      source = "ts"
      format = "02/Jan/2006:15:04:05 -0700"
    }
    stage.regex {
      source     = "status"
      expression = "^(?P<status_digit>\\d)\\d\\d$"
    }
    stage.template {
      source   = "status_class"
      template = "{{ .status_digit }}xx"
    }
    // who asked: human by default; bot by user agent; self = our probes, scripts and the home network
    stage.static_labels {
      values = { client = "human" }
    }
    stage.match {
      selector = "{log=\"access\"} |~ \"\\\"[^\\\"]*(?i:bot|crawl|spider|slurp|facebookexternalhit)[^\\\"]*\\\" rt=\""
      stage.static_labels {
        values = { client = "bot" }
      }
    }
    stage.match {
      selector = "{log=\"access\"} |~ \"gfilho-monitor|curl/|[Pp]ython-urllib|HeadlessChrome|Chrome-Lighthouse|self-audit|\\\"node\\\" rt=|^(127\\\\.0\\\\.0\\\\.1|::1|10\\\\.10\\\\.10\\\\.\\\\d+|192\\\\.168\\\\.1\\\\.\\\\d+) \""
      stage.static_labels {
        values = { client = "self" }
      }
    }
    stage.labels {
      values = { status_class = "" }
    }
    stage.structured_metadata {
      values = { method = "", path = "", status = "", country = "" }
    }
    stage.metrics {
      metric.counter {
        name              = "site_requests_total"
        description       = "Requests answered by nginx, per client class (human, bot, self) and status class"
        match_all         = true
        action            = "inc"
        max_idle_duration = "24h"
      }
    }
  }
  // error log: 2026/10/20 14:06:23 [error] ...
  stage.match {
    selector = "{log=\"error\"}"
    stage.regex {
      expression = "^(?P<ts>\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[(?P<level>[a-z]+)\\]"
    }
    stage.timestamp {
      source   = "ts"
      format   = "2006/01/02 15:04:05"
      location = "Europe/Lisbon"
    }
    stage.labels {
      values = { level = "" }
    }
  }
  forward_to = [loki.write.local.receiver, loki.write.ct108.receiver]
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

// Only the units that matter for the site (matches on the same field are ORed by the journal).
loki.source.journal "units" {
  path          = "/var/log/journal"
  matches       = "_SYSTEMD_UNIT=nginx.service _SYSTEMD_UNIT=cloudflared.service _SYSTEMD_UNIT=logrotate.service _SYSTEMD_UNIT=gfilho-metrics.service"
  max_age       = "24h"
  labels        = { job = "systemd-journal" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.journal.receiver]
}

// cloudflared logs every line at journal priority "info" and writes the real level in the message
// (" WRN ", " ERR "...): use that one, so warnings show up as warnings in Grafana.
loki.process "journal" {
  stage.match {
    selector = "{unit=\"cloudflared.service\"}"
    stage.regex {
      expression = "\\s(?P<lvl>DBG|INF|WRN|ERR|FTL)\\s"
    }
    stage.template {
      source   = "lvl"
      template = "{{ if eq .Value \"WRN\" }}warning{{ else if eq .Value \"ERR\" }}error{{ else if eq .Value \"FTL\" }}critical{{ else if eq .Value \"DBG\" }}debug{{ else }}info{{ end }}"
    }
    stage.labels {
      values = { level = "lvl" }
    }
  }
  forward_to = [loki.write.local.receiver, loki.write.ct108.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

loki.write "ct108" {
  endpoint {
    url = "http://10.10.10.27:3100/loki/api/v1/push"
  }
}
