<mxfile host="drawio" agent="gfilho-website"><diagram id="Deploy pipeline" name="Deploy pipeline"><mxGraphModel dx="1320" dy="815" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="815" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="gfilho.net — Release workflow and deploy pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1280" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Every deploy is backed up first and checked afterwards; staging and production run exactly the same steps" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1280" height="20" as="geometry"/></mxCell><mxCell id="flow" value="Release workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#2B5797;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1280" height="140" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Edit site/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;HTML · CSS · JS&lt;br&gt;bump ?v= on changed assets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="flow"><mxGeometry x="30" y="45" width="220" height="75" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;deploy.sh staging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;→ /var/www/gfilho-staging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="flow"><mxGeometry x="280" y="45" width="220" height="75" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;http://localhost:8089&lt;br&gt;both themes · phone widths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="flow"><mxGeometry x="530" y="45" width="220" height="75" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;deploy.sh production&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;→ /var/www/html&lt;br&gt;live on https://gfilho.net&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="flow"><mxGeometry x="780" y="45" width="220" height="75" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Commit and push&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;including site/sitemap.xml&lt;br&gt;when its date changed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="flow"><mxGeometry x="1030" y="45" width="220" height="75" as="geometry"/></mxCell><mxCell id="sf0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2B5797;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2B5797;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="flow" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sf1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2B5797;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2B5797;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="flow" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sf2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2B5797;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2B5797;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="flow" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sf3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2B5797;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2B5797;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="flow" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pipe" value="Inside deploy/deploy.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#2B5797;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1280" height="545" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;deploy.sh &amp;lt;target&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;staging | production&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;arcSize=50;" vertex="1" parent="pipe"><mxGeometry x="20" y="75" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Running as root&lt;/b&gt;&lt;br&gt;and site/index.html&lt;br&gt;found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="pipe"><mxGeometry x="240" y="40" width="200" height="140" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;index.html&lt;/b&gt;&lt;br&gt;differs from the&lt;br&gt;deployed copy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="pipe"><mxGeometry x="490" y="40" width="200" height="140" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Check security.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;warns 30 days before Expires&lt;br&gt;(never stops the deploy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="740" y="70" width="220" height="80" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Back up the target&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;/var/backups/gfilho/&lt;br&gt;&amp;lt;timestamp&amp;gt;-&amp;lt;target&amp;gt;/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9F7;strokeColor=#6A1B9A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="1010" y="70" width="240" height="80" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;Stop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;usage or permission error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="245" y="230" width="190" height="65" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Update the sitemap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;&amp;lt;lastmod&amp;gt; set to today&lt;br&gt;in site/sitemap.xml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="495" y="230" width="190" height="75" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Sync site/ → target&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;rsync --delete: exact copy of site/&lt;br&gt;dotfiles excluded, except /.well-known/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="1010" y="230" width="240" height="90" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;/ returns 200&lt;/b&gt;&lt;br&gt;and /no-such-page&lt;br&gt;returns 404?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="pipe"><mxGeometry x="1015" y="360" width="230" height="140" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;deploy complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;arcSize=50;" vertex="1" parent="pipe"><mxGeometry x="745" y="395" width="200" height="70" as="geometry"/></mxCell><mxCell id="x6" value="&lt;b&gt;Exit 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;prints the rsync command&lt;br&gt;that restores the backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="pipe"><mxGeometry x="445" y="385" width="220" height="90" as="geometry"/></mxCell><mxCell id="q0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#1565C0;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="pipe" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2E7D32;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="p1" target="p2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="q1n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#C62828;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="p1" target="x1"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="q2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;or