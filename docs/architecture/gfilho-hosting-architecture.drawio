<mxfile host="drawio" agent="gfilho-website"><diagram id="Hosting architecture" name="Hosting architecture"><mxGraphModel dx="1320" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="gfilho.net — Hosting architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1280" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Static site served by nginx in WSL 2 and published through a Cloudflare Tunnel: the origin listens on loopback only and is never exposed to the internet" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1280" height="20" as="geometry"/></mxCell><mxCell id="vis" value="Visitors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#1565C0;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="200" height="380" as="geometry"/></mxCell><mxCell id="i_read" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="vis"><mxGeometry x="74" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="t_read" value="&lt;b&gt;Readers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;web browsers&lt;br&gt;desktop and mobile&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1B2733;fontFamily=Segoe UI;" vertex="1" parent="vis"><mxGeometry x="10" y="108" width="180" height="60" as="geometry"/></mxCell><mxCell id="i_crawl" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="vis"><mxGeometry x="74" y="200" width="52" height="52" as="geometry"/></mxCell><mxCell id="t_crawl" value="&lt;b&gt;Crawlers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;search engines&lt;br&gt;social link previews&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1B2733;fontFamily=Segoe UI;" vertex="1" parent="vis"><mxGeometry x="10" y="258" width="180" height="60" as="geometry"/></mxCell><mxCell id="cf" value="Cloudflare (edge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#C8590A;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="280" height="380" as="geometry"/></mxCell><mxCell id="dns" value="&lt;b&gt;DNS &amp;amp; TLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;proxied records · edge certificate&lt;br&gt;TLS 1.2+ · HSTS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#C8590A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="cf"><mxGeometry x="15" y="45" width="250" height="80" as="geometry"/></mxCell><mxCell id="edge" value="&lt;b&gt;Edge features&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;Always Use HTTPS&lt;br&gt;static asset cache · email obfuscation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#C8590A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="cf"><mxGeometry x="15" y="145" width="250" height="80" as="geometry"/></mxCell><mxCell id="tun" value="&lt;b&gt;Tunnel ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;gfilho.net, www → localhost:8088&lt;br&gt;any other host → 404&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#C8590A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="cf"><mxGeometry x="15" y="245" width="250" height="80" as="geometry"/></mxCell><mxCell id="host" value="Windows host · WSL 2 · Ubuntu 26.04 LTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#C24E1C;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="720" height="560" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;Monitoring (Docker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;metrics and logs of nginx,&lt;br&gt;tunnel and host&lt;br&gt;Grafana localhost:3000&lt;br&gt;loopback only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9F7;strokeColor=#6A1B9A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="host"><mxGeometry x="20" y="45" width="170" height="160" as="geometry"/></mxCell><mxCell id="cfd" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;systemd service&lt;br&gt;outbound-only&lt;br&gt;connection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#C8590A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="host"><mxGeometry x="20" y="230" width="170" height="110" as="geometry"/></mxCell><mxCell id="ngx" value="nginx 1.28 · loopback only · stub_status :8090" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#2E7D32;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="host"><mxGeometry x="225" y="45" width="475" height="330" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;gfilho-common.conf (shared by both servers)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;301 for http:// and www. → https://gfilho.net (CF-Visitor)&lt;br&gt;relative redirects · security headers · cache rules by path&lt;br&gt;custom 404 (also for 403) · dotfiles and backups never served&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="ngx"><mxGeometry x="15" y="45" width="445" height="120" as="geometry"/></mxCell><mxCell id="prod" value="&lt;b&gt;Production&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;127.0.0.1:8088&lt;br&gt;/var/www/html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="ngx"><mxGeometry x="15" y="185" width="215" height="110" as="geometry"/></mxCell><mxCell id="stg" value="&lt;b&gt;Staging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;127.0.0.1:8089&lt;br&gt;/var/www/gfilho-staging&lt;br&gt;local preview only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="ngx"><mxGeometry x="245" y="185" width="215" height="110" as="geometry"/></mxCell><mxCell id="wc" value="&lt;b&gt;Working copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;git checkout&lt;br&gt;site/ · deploy/ · tools/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292F;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="host"><mxGeometry x="20" y="420" width="170" height="115" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;deploy/deploy.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;staging | production&lt;br&gt;backup → sync → smoke test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="host"><mxGeometry x="240" y="420" width="215" height="115" as="geometry"/></mxCell><mxCell id="bak" value="&lt;b&gt;/var/backups/gfilho&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;one snapshot per deploy&lt;br&gt;&amp;lt;timestamp&amp;gt;-&amp;lt;target&amp;gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F3E9F7;strokeColor=#6A1B9A;fontSize=13;fontFamily=Segoe UI;fontColor=#1B2733;strokeWidth=1.5;" vertex="1" parent="host"><mxGeometry x="475" y="420" width="225" height="115" as="geometry"/></mxCell><mxCell id="gh" value="Source repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#24292F;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="480" height="140" as="geometry"/></mxCell><mxCell id="i_gh" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" 