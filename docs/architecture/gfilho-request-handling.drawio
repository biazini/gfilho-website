<mxfile host="drawio" agent="gfilho-website"><diagram id="Request handling" name="Request handling"><mxGraphModel dx="1320" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="590" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="gfilho.net — How nginx answers a request" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1280" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="deploy/nginx/gfilho-common.conf, applied to both the production and the staging server" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1280" height="20" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6573&quot;&gt;from cloudflared&lt;br&gt;Host · URI · CF-Visitor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;arcSize=50;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="170" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Host is www.gfilho.net&lt;/b&gt;&lt;br&gt;or CF-Visitor&lt;br&gt;scheme is http?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="1"><mxGeometry x="225" y="120" width="210" height="140" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Dotfile&lt;/b&gt; (except&lt;br&gt;/.well-known/) or a&lt;br&gt;backup / editor file?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="210" height="140" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;File exists?&lt;/b&gt;&lt;br&gt;try_files $uri $uri/" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=12;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=18;" vertex="1" parent="1"><mxGeometry x="735" y="120" width="210" height="140" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;200 OK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;the file from the web root&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="310" height="80" as="geometry"/></mxCell><mxCell id="cache" value="&lt;b&gt;Cache lifetime by path&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;HTML: always revalidated (ETag)&lt;br&gt;/assets/fonts/: 1 year · /assets/img/: 30 days&lt;br&gt;/assets/css/, /assets/js/: 1 hour (bump ?v= on change)&lt;br&gt;icons, manifest, xml, txt: 1 day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="990" y="290" width="310" height="130" as="geometry"/></mxCell><mxCell id="r301" value="&lt;b&gt;301 Moved Permanently&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;→ https://gfilho.net + URI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="240" y="320" width="180" height="80" as="geometry"/></mxCell><mxCell id="r404" value="&lt;b&gt;404 Not Found&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;custom page /404.html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="320" width="370" height="80" as="geometry"/></mxCell><mxCell id="hdr" value="&lt;b&gt;Security headers on every response: 200, 301 and 404 (add_header … always)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A6573&quot;&gt;Content-Security-Policy: default-src 'none', scripts, styles, images and fonts from the same origin only · X-Content-Type-Options: nosniff · X-Frame-Options: DENY&lt;br&gt;Referrer-Policy: strict-origin-when-cross-origin · Permissions-Policy: camera, microphone, geolocation, payment and usb disabled · Cross-Origin-Opener-Policy: same-origin · server_tokens off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1280" height="100" as="geometry"/></mxCell><mxCell id="g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#1565C0;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#546E7A;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="g3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#546E7A;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="g4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2E7D32;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="ok"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="g5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#B08800;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#B08800;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="r301"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="g6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#C62828;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1486;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="r404"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="g7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#C62828;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8378;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="r404"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="g8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#2E7D32;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontStyle=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="ok" target="cache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
